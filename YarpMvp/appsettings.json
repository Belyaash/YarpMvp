{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "YarpOpenApi": {
    "MergeDocuments" : true,
    "Clusters": {
      "service-a-cluster":  { "Title": "Products API", "OpenApiPath": "/openapi/v1.json" },
      "service-b-cluster":  { "Title": "service-b-cluster API", "OpenApiPath": "/openapi/v1.json" }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "service-a-route": {
        "ClusterId": "service-a-cluster",
        "Match": {
          "Path": "/api/{**catch-all}",
          "Headers": [
            {
              "Name": "X-Service",
              "Values": [
                "foo1"
              ]
            }
          ]
        }
      },
      "service-b-route": {
        "ClusterId": "service-b-cluster",
        "Match": {
          "Path": "/api/{**catch-all}",
          "Headers": [
            {
              "Name": "X-Service",
              "Values": [
                "foo2"
              ]
            }
          ]
        }
      }
    },
    "Clusters": {
      "service-a-cluster": {
        "Destinations": {
          "service-a-destination": {
            "Address": "http://localhost:5195/"
          }
        }
      },
      "service-b-cluster": {
        "Destinations": {
          "service-b-destination": {
            "Address": "http://localhost:5175/"
          }
        }
      }
    }
  }
}
